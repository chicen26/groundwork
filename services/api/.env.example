# Copy to .env and fill in. Never commit .env.

GROUNDWORK_ENVIRONMENT=development
GROUNDWORK_VERSION=0.1.0

# Pinned rulebook version served to clients (see docs/DECISIONS.md, D3).
GROUNDWORK_RULEBOOK_VERSION=2026.08

# Comma-separated allowed origins. Keep "*" only in development.
GROUNDWORK_CORS_ORIGINS=*

# Postgres with PostGIS. See services/api/docs/DATABASE.md for local setup.
GROUNDWORK_DATABASE_URL=postgresql://localhost/groundwork_dev
GROUNDWORK_DB_POOL_MIN_SIZE=1
GROUNDWORK_DB_POOL_MAX_SIZE=10

# Scratch database for the test suite. Its schema is dropped and rebuilt every run, so never point
# this at a database holding real data. Database tests skip when it is unset.
GROUNDWORK_TEST_DATABASE_URL=postgresql://localhost/groundwork_test

# Supabase JWT secret. While empty, the API accepts the X-Groundwork-User development header
# instead — refused outright in production and whenever this secret is set. See app/auth.py.
GROUNDWORK_SUPABASE_JWT_SECRET=
GROUNDWORK_SUPABASE_JWT_AUDIENCE=authenticated

# Where sanitised photos are written (EXIF is stripped before anything lands here).
GROUNDWORK_PHOTO_STORAGE_ROOT=./var/photos

# --- Added in a later step (hosted storage) ---
# GROUNDWORK_SUPABASE_URL=https://<project>.supabase.co
# GROUNDWORK_SUPABASE_SERVICE_KEY=
